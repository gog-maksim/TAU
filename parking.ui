   <string notr="true">/* === СВЕТЛАЯ ТЕМА — принудительно читаемый текст === */
QMainWindow { background: #f4f6f9; }
QWidget { color: #1a2b4c; }
QLabel { color: #1a2b4c; }
QGroupBox { font-weight: bold; color: #1a2b4c; border: 1px solid #d0d7e3; border-radius: 6px; margin-top: 12px; padding-top: 12px; background: white; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #1a2b4c; }
QLineEdit { background: white; color: #1a2b4c; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 8px; selection-background-color: #d6e4ff; selection-color: #1a2b4c; }
QLineEdit:focus { border: 1px solid #3b82f6; }
QComboBox { background: white; color: #1a2b4c; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 8px; }
QComboBox QAbstractItemView { background: white; color: #1a2b4c; selection-background-color: #eef2f7; selection-color: #1a2b4c; border: 1px solid #cbd5e1; }
QComboBox::drop-down { border: none; width: 24px; }
QTableWidget { background: white; color: #1a2b4c; border: 1px solid #d0d7e3; border-radius: 6px; gridline-color: #eef2f7; selection-background-color: #e3edff; selection-color: #1a2b4c; alternate-background-color: #f8fafc; }
QHeaderView::section { background: #eef2f7; color: #1a2b4c; padding: 6px; border: none; border-right: 1px solid #d0d7e3; font-weight: bold; font-size: 12px; }
QTableWidget::item { color: #1a2b4c; padding: 4px; }
QTableWidget::item:selected { background: #dbeafe; color: #1a2b4c; }
QProgressBar { border: 1px solid #d0d7e3; border-radius: 5px; background: #eef2f7; text-align: center; color: #1a2b4c; }
QProgressBar::chunk { border-radius: 4px; }
QStatusBar { background: #eef2f7; color: #1a2b4c; }
QScrollBar:vertical, QScrollBar:horizontal { background: #f1f5f9; border: none; }
</string>
